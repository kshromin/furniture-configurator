# Образец переменных для сервера. НАСТОЯЩИЙ .env в git не попадает — он живёт только на сервере
# (и копией в папке материалов на Яндексе). Значения секретов берутся из gen-keys.py.

# --- Supabase: секреты (python3 gen-keys.py) ---
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# --- Адреса ---
# внешний адрес API: по нему в браузер ходит конфигуратор
API_EXTERNAL_URL=https://api.khrom-in.ru
SUPABASE_PUBLIC_URL=https://api.khrom-in.ru
SITE_URL=https://config.khrom-in.ru
# куда разрешено возвращать после входа и подтверждения почты
ADDITIONAL_REDIRECT_URLS=https://config.khrom-in.ru,https://khrom-in.ru

# --- Почта, которой пользуется сам сервис (письма о входе и восстановлении пароля) ---
# ЗАПОЛНИТЬ ПОЗЖЕ: отдельный SMTP-сервис рассылки. Пока пусто — письма уходить не будут,
# вход по паролю это не ломает.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=KHROM
SMTP_ADMIN_EMAIL=admin@khrom-in.ru

# --- Хранилище S3 (бэкапы и файлы) ---
S3_BUCKET=khrom-files
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
# сами ключи кладём не сюда, а в ~/.aws/credentials пользователя deploy — см. README
