# Caddy — единственное, что смотрит наружу. HTTPS-сертификаты берёт сам (Let's Encrypt),
# обновляет сам, настраивать нечего.
#
# ГЛАВНОЕ ПРАВИЛО: здесь должны быть ТОЛЬКО те имена, которые уже указывают A-записью на этот
# сервер. На лишние Caddy будет безуспешно запрашивать сертификат и упрётся в лимиты Let's Encrypt
# (5 неудач на домен в час), после чего и рабочие имена перестанут выпускаться.
#
# Сейчас идёт ПЕРЕХОДНЫЙ ПЕРИОД: старый config.khrom-in.ru остаётся на GitHub Pages с облачной
# базой и работает как работал, а конфигуратор на нашем сервере поднимается сразу на ПОСТОЯННОМ
# имени mebel.khrom-in.ru. Отдельное «тестовое» имя не нужно: mebel — новое, на него ничего не
# завязано, поэтому оно и стенд для проверки, и будущий рабочий адрес.

{
	email admin@khrom-in.ru
}

# --- Наш Supabase (постоянное имя) -----------------------------------------
api.khrom-in.ru {
	encode zstd gzip

	# Наружу пропускаем ТОЛЬКО рабочие пути API. Всё остальное — 404.
	# Причина: на корне Kong отдаёт Supabase Studio, а это полный доступ к базе, прикрытый
	# одним паролем из установщика. Держать такое открытым в интернет незачем — в Studio
	# ходим через SSH-туннель (см. README).
	# handle, а не reverse_proxy + respond: директивы Caddy выполняются в СВОЁМ порядке,
	# а не в порядке строк в файле, и respond перехватывает всё раньше проксирования.
	# handle-блоки взаимоисключающие, порядок в них явный.
	@api path /auth/* /rest/* /realtime/* /storage/* /functions/* /graphql/*
	handle @api {
		# Websockets для чатов Caddy проксирует сам, отдельной настройки не нужно
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		respond 404
	}
}

# --- Конфигуратор (постоянный адрес) ---------------------------------------
mebel.khrom-in.ru {
	root * /srv/khrom/config
	encode zstd gzip
	file_server

	@static path *.js *.css *.png *.webp *.jpg *.bmp
	header @static Cache-Control "public, max-age=604800"
	@html path *.html /
	header @html Cache-Control "no-cache"
}

# --- Сайт project.khrom-in.ru ----------------------------------------------
# A-запись переведена с GitHub Pages на наш сервер 09.08.2026.
project.khrom-in.ru {
	root * /srv/khrom/sites/project
	encode zstd gzip
	file_server

	# try_files с {path}.html: ссылки вида /mebel открываются как mebel.html —
	# на GitHub Pages это работало само, у нас надо сказать явно.
	# Отката на /index.html НЕТ намеренно: с ним любая опечатка в адресе показывала бы
	# главную страницу с кодом 200, и ни человек, ни поисковик не понимали бы, что страницы нет
	try_files {path} {path}/ {path}.html

	@static path *.js *.css *.png *.webp *.jpg *.jpeg *.svg *.mp4 *.pdf
	header @static Cache-Control "public, max-age=604800"
	@html path *.html /
	header @html Cache-Control "no-cache"
}

# --- Панель Supabase Studio ------------------------------------------------
# Отдельное имя и пароль: внутри неё полный доступ к базе.
